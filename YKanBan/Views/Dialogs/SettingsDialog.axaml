<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YKanBan.ViewModels.Dialogs"
        xmlns:vmBase="using:YKanBan.ViewModels"
        xmlns:lang="using:YKanBan"
        x:Class="YKanBan.Views.Dialogs.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Title="{x:Static lang:Resources.Settings_Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="440" CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static lang:Resources.Settings_Language}"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmBase:OptionItem">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{x:Static lang:Resources.Settings_Language_RestartNotice}"
                       IsVisible="{Binding RestartNoticeVisible}"
                       FontStyle="Italic" Opacity="0.7"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static lang:Resources.Settings_Theme}"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmBase:OptionItem">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Static lang:Resources.Settings_Confirmations}"/>
            <CheckBox Content="{x:Static lang:Resources.Settings_ConfirmDeleteCard}" IsChecked="{Binding ConfirmDeleteCard}"/>
            <CheckBox Content="{x:Static lang:Resources.Settings_ConfirmDeleteColumn}" IsChecked="{Binding ConfirmDeleteColumn}"/>
            <CheckBox Content="{x:Static lang:Resources.Settings_ConfirmDeleteTag}" IsChecked="{Binding ConfirmDeleteTag}"/>
            <CheckBox Content="{x:Static lang:Resources.Settings_ConfirmDiscardEdit}" IsChecked="{Binding ConfirmDiscardEdit}"/>
        </StackPanel>

        <Button Content="{x:Static lang:Resources.Common_Close}" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="90"/>
    </StackPanel>
</Window>
