<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YKanBan.ViewModels.Dialogs"
        xmlns:lang="using:YKanBan"
        x:Class="YKanBan.Views.Dialogs.AboutDialog"
        x:DataType="vm:AboutDialogViewModel"
        Title="{x:Static lang:Resources.About_Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="380" CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding ApplicationName}" FontSize="22" FontWeight="Bold"/>

        <TextBlock Text="{Binding VersionText}" Opacity="0.8"/>

        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="{x:Static lang:Resources.About_Repository}" Opacity="0.7" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding RepositoryUrl}" TextWrapping="Wrap"/>
        </Grid>

        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{x:Static lang:Resources.About_License}" Opacity="0.7" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding LicenseValue}"/>
        </Grid>

        <Button Content="{x:Static lang:Resources.Common_Close}" IsCancel="True"
                HorizontalAlignment="Right" MinWidth="90" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
