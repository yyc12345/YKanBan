<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YKanBan.ViewModels.Dialogs"
        xmlns:lang="using:YKanBan"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
        x:Class="YKanBan.Views.Dialogs.AboutDialog"
        x:DataType="vm:AboutDialogViewModel"
        Title="{x:Static lang:Resources.About_Title}"
        Width="460" Height="320" MinWidth="460" MinHeight="320" CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">

        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Version}"/>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static lang:Resources.About_Repository}" FontWeight="SemiBold"/>
                <HyperlinkButton Content="{Binding RepositoryUrl}" NavigateUri="{Binding RepositoryUrl}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static lang:Resources.About_License}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding License}"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Content="{x:Static lang:Resources.Common_Ok}"
                Click="OnCloseClick" HorizontalAlignment="Right" MinWidth="90"
                IsDefault="True" IsCancel="True"
                Theme="{DynamicResource SolidButton}" Classes="Primary"/>

    </Grid>
</Window>
