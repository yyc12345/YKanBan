<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YKanBan.ViewModels.Dialogs"
        xmlns:lang="using:YKanBan"
        xmlns:icons="using:IconPacks.Avalonia.Lucide"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="YKanBan.Views.Dialogs.CardEditorDialog"
        x:DataType="vm:CardEditorViewModel"
        Title="{Binding WindowTitle}"
        Width="520" Height="560" MinWidth="520" MinHeight="560" CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">

                <TextBlock Text="{x:Static lang:Resources.CardDialog_Title}"/>
                <TextBox Text="{Binding Title}"/>

                <TextBlock Text="{x:Static lang:Resources.CardDialog_Content}" Margin="0,6,0,0"/>
                <TextBox Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Height="160"/>

                <TextBlock Text="{x:Static lang:Resources.CardDialog_Tags}" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding AssignedTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssignedTagViewModel">
                            <Border Background="{Binding Background}" CornerRadius="8"
                                    Padding="6,2" Margin="0,0,4,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <Button Command="{Binding RemoveCommand}" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <icons:PackIconLucide Kind="X" Width="10" Height="10"
                                                            Foreground="{Binding Foreground}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static lang:Resources.CardDialog_AddTag}"
                        Command="{Binding AddTagCommand}" HorizontalAlignment="Left"/>

                <StackPanel Spacing="2" IsVisible="{Binding !IsNew}" Margin="0,8,0,0">
                    <TextBlock Text="{Binding IdLine}" Classes="Secondary"/>
                    <TextBlock Text="{Binding CreatedLine}" Classes="Secondary"/>
                    <TextBlock Text="{Binding ModifiedLine}" Classes="Secondary"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Content="{x:Static lang:Resources.Common_Ok}" Click="OnOkClick" MinWidth="90" IsDefault="True"
                    Theme="{DynamicResource SolidButton}" Classes="Primary"/>
            <Button Content="{x:Static lang:Resources.Common_Cancel}" Click="OnCancelClick" MinWidth="90"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
