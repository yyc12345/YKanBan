<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:YKanBan.ViewModels.Dialogs"
                      xmlns:dialogs="using:YKanBan.Views.Dialogs"
                      xmlns:lang="using:YKanBan"
                      x:Class="YKanBan.Views.Dialogs.ConfirmDialog"
                      x:DataType="vm:ConfirmDialogViewModel"
                      Title="{x:Static lang:Resources.Confirm_Title}"
                      MinWidth="360" MaxWidth="520"
                      WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                    Classes="Danger" MinWidth="90" IsDefault="True"/>
            <Button Content="{x:Static lang:Resources.Common_Cancel}" Command="{Binding CancelCommand}"
                    MinWidth="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
