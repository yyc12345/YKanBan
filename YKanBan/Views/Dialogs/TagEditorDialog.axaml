<dialogs:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:YKanBan.ViewModels.Dialogs"
                      xmlns:dialogs="using:YKanBan.Views.Dialogs"
                      xmlns:lang="using:YKanBan"
                      x:Class="YKanBan.Views.Dialogs.TagEditorDialog"
                      x:DataType="vm:TagEditorDialogViewModel"
                      x:Name="Root"
                      Title="{Binding Title}"
                      SizeToContent="Height" Width="440"
                      WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static lang:Resources.Field_Name}"/>
            <TextBox Text="{Binding Name}"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Static lang:Resources.TagEditor_ColorLabel}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Color}" Width="120" Watermark="{x:Static lang:Resources.Field_Color}"/>
                <Border Width="28" Height="28" CornerRadius="4" Background="{Binding ColorPreview}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                        <Button Command="{Binding #Root.((vm:TagEditorDialogViewModel)DataContext).PickSwatchCommand}"
                                CommandParameter="{Binding Hex}"
                                ToolTip.Tip="{Binding Hex}"
                                Width="24" Height="24" Padding="0" CornerRadius="4"
                                Background="{Binding Brush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static lang:Resources.Field_Description}"/>
            <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="72" MaxHeight="200"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Static lang:Resources.Common_Ok}" Command="{Binding ConfirmCommand}"
                    Classes="Primary" MinWidth="90" IsDefault="True"/>
            <Button Content="{x:Static lang:Resources.Common_Cancel}" Command="{Binding CancelCommand}"
                    MinWidth="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindow>
