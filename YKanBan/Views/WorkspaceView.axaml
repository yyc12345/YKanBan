<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YKanBan.ViewModels"
             xmlns:lang="using:YKanBan"
             xmlns:icons="using:IconPacks.Avalonia.Lucide"
             xmlns:board="using:YKanBan.Views.Board"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="YKanBan.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Top display area: workspace name and path, plus the three action buttons. -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource TopBarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WorkspaceName}" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding WorkspacePath}" FontSize="12" Opacity="0.65"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:PackIconLucide Kind="FileDown" Width="16" Height="16"/>
                            <TextBlock Text="{x:Static lang:Resources.Main_Export}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:PackIconLucide Kind="Settings" Width="16" Height="16"/>
                            <TextBlock Text="{x:Static lang:Resources.Main_Settings}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAboutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:PackIconLucide Kind="Info" Width="16" Height="16"/>
                            <TextBlock Text="{x:Static lang:Resources.Main_About}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tags and board tabs; their contents arrive with the corresponding features. -->
        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="{x:Static lang:Resources.Tab_Board}">
                <board:BoardView DataContext="{Binding Board}"/>
            </TabItem>
            <TabItem Header="{x:Static lang:Resources.Tab_Tags}"/>
        </TabControl>

    </Grid>
</UserControl>
