<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YKanBan.ViewModels.Pages"
             x:Class="YKanBan.Views.Pages.WorkspacePage"
             x:DataType="vm:WorkspacePageViewModel">
    <StackPanel Margin="24,20" Spacing="6">
        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding FullPath}" Opacity="0.6" FontSize="12"/>
    </StackPanel>
</UserControl>
