<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:YKanBan"
             x:Class="YKanBan.Views.Pages.WelcomePage">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="{x:Static lang:Resources.App_Name}" FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Static lang:Resources.Welcome_Hint}" Opacity="0.65"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
